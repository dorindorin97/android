<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">
    <TextView android:id="@+id/mdnsItemType" android:layout_width="70dp" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/mdnsItemName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/mdnsItemAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#555555" android:fontFamily="monospace" />
</LinearLayout>
